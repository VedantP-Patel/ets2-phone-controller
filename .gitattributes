* text=auto eol=lf

# Windows batch & PowerShell scripts must preserve CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Shell & Gradle wrapper scripts must preserve LF
*.sh text eol=lf
gradlew text eol=lf

# Binary assets
*.apk binary
*.dll binary
*.exe binary
*.jar binary
*.png binary
*.jpg binary
*.webp binary
*.zip binary
